{
  "manifest_version": 3,
  "name": "MyHours Percentage Calculator",
  "description": "Calculates Total / All Hours percentage on MyHours track page.",
  "version": "1.1",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://*.myhours.com/*"],
      "js": ["content.js"],
      "css": ["style.css", "spinner.css"],
      "run_at": "document_idle"
    }
  ]
}
